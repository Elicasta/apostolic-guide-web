NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pathway AI narration / existing Apostolic Guide publishing AI
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-5-mini
# Optional. Falls back to OPENAI_SCRIPT_MODEL when omitted.
OPENAI_SCRIPT_CHECK_MODEL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_SPEED=0.88
# Video Studio uses word timestamps to align the finished narration to the approved script.
# Keep whisper-1 unless a timestamp-capable replacement is explicitly supported.
OPENAI_VIDEO_TRANSCRIBE_MODEL=whisper-1
# GPT-5.6 Sol directs the richer talking-point timeline and creates channel publishing copy.
OPENAI_VIDEO_DIRECTOR_MODEL=gpt-5.6-sol
# Dedicated Video Producer API key. Keep this separate from the existing publishing key above.
VIDEO_PRODUCER_OPENAI_API_KEY=
# Optional Video Producer override. Falls back to OPENAI_VIDEO_DIRECTOR_MODEL.
OPENAI_VIDEO_PRODUCER_MODEL=gpt-5.6-sol
OPENAI_VIDEO_PUBLISHING_MODEL=gpt-5.6-sol
# Optional. Selects and scores the strongest short-form moments from approved narration.
OPENAI_SOCIAL_CLIP_MODEL=gpt-5.6-sol
# Thumbnail model only creates the visual background. Exact text/logo are composited by Apostolic Guide.
OPENAI_VIDEO_THUMBNAIL_MODEL=gpt-image-2

# Video Producer private large-file storage.
# Connect a Vercel Blob store to the project. Vercel normally injects this automatically.
BLOB_READ_WRITE_TOKEN=

# Video Studio / Video Producer async worker bridge
# Fine-grained GitHub token with permission to dispatch Actions in this repository.
VIDEO_STUDIO_GITHUB_TOKEN=
VIDEO_STUDIO_GITHUB_REPOSITORY=Elicasta/apostolic-guide-web
# GitHub Actions repository secrets needed by media workers:
# VIDEO_STUDIO_SUPABASE_URL and VIDEO_STUDIO_SUPABASE_SERVICE_ROLE_KEY (existing Pathway Video worker)
# VIDEO_PRODUCER_OPENAI_API_KEY (Video Producer long-form transcription worker)

# Vercel automatically sends this bearer secret to the scheduled publishing cron.
CRON_SECRET=

# YouTube / Instagram / TikTok publishing credentials are stored server-side from
# Studio > Setup > Social publishing credentials in analytics.integration_secrets.
# They are intentionally not duplicated as public/client environment variables.

# Resend contact sync and welcome email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Apostolic Guide <updates@apostolicguide.com>"

# Optional Resend topic IDs. Create matching topics in Resend and paste their IDs here.
RESEND_LIVE_TEACHINGS_TOPIC_ID=
RESEND_NEW_ARTICLES_TOPIC_ID=
